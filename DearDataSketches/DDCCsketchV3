void draw() {
  background(255);
  int barWidth = 10;
  
  for(Stone s : stones) {  
    int x = s.getNumber() * 10;
    int barHeight = s.getSize() * 5;
    int y = (300 - (getTextureY(s.getTexture()) * 30)) + (int)random(-15,15);
    fill(getColorEllipse(s.getStoneColor()));
    rect(x,y, barWidth, barHeight);
    noLoop();
  }
}


public color getColorEllipse(String stoneColor) {
    if(stoneColor.equals("black")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(125,125,125);
    if(stoneColor.equals("white")) return color(255,255,255);
    if(stoneColor.equals("brown")) return color(0,0,0);
    if(stoneColor.equals("red")) return color(255,0,0);
    if(stoneColor.equals("orange")) return color(0,0,0);
    if(stoneColor.equals("yellow")) return color(0,0,0);
    if(stoneColor.equals("green")) return color(0,0,0);
    if(stoneColor.equals("blue")) return color(0,0,0);
    if(stoneColor.equals("pink")) return color(0,0,0);
    if(stoneColor.equals("purple")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);
    if(stoneColor.equals("grey")) return color(0,0,0);

    else return color(128, 128, 128);
  }
  
  
    public int getTextureY(String texture) {
if(texture.equals("smooth")) return 7;
if(texture.equals("round")) return 6;
if(texture.equals("waxy")) return 5;
if(texture.equals("grainy")) return 4;
if(texture.equals("rough")) return 3;
if(texture.equals("jagged")) return 2;
if(texture.equals("hard")) return 1;
else return 4;
  }
