import java.util.ArrayList;

class Stone {
  public int number;
  public String stoneColor;
  public int size;
  public String texture;
  public String name;
  
  public Stone(int number, String stoneColor, int size, String texture, String name) {
    this.number = number;
    this.stoneColor = stoneColor;
   this.size = size;
   this.texture = texture;
   this.name = name;
  }
  
  public int getNumber() { 
    return number;
  }
  public String getStoneColor() {
    return stoneColor;
  }
   public int getSize() {
    return size;
  }
  public String getTexture() {
    return texture;
  }
}


class Star {
  float x, y, size, speed;
  
  public Star(float x, float y, float s, float sp) {
    this.x = x; 
    this.y = y; 
    this.size = s; 
    this.speed = sp;
  }
}












ArrayList<Stone> stones = new ArrayList<>(100);
ArrayList<Star> stars = new ArrayList<>(80);
boolean inverted = false;

void setup() {
  size(1250, 350);
  surface.setTitle("Space Stones");
  frameRate(30);

  String[] dearDataLines = loadStrings("DearData5.0.md");
  for (String e : dearDataLines) {
    if (e.trim().length() == 0) continue;
    String[] dataSplit = e.split(",");
    if (dataSplit.length < 5) continue;
    stones.add(new Stone(
      int(dataSplit[0].trim()), dataSplit[1].trim(), int(dataSplit[2].trim()), dataSplit[3].trim(), dataSplit[4].trim()));
  }
  for (int i = 0; i < 80; i++) {
    stars.add(new Star(random(width), random(height), random(0.5, 5), random(0.3, 1.5)));
  }
}

void draw() {
  if (inverted == true) {
    background(255, 255, 255);
  } else {
    background(0, 0, 0);
  }


  for (Star p : stars) {
    p.x += p.speed;
    if (p.x > width + 5) {
      p.x = -5;
    }

    if (inverted) {
      fill(0, 0, 0, 60);
    } else {
      fill(255, 255, 255, 60);
    }
    noStroke();
    ellipse(p.x, p.y, p.size, p.size);
  }


  for (Stone s : stones) {
    int x = s.getNumber() * 12;
    int Height = s.getSize() * 5;
    int y = (300 - (getTextureY(s.getTexture()) * 30));

    if (inverted) {
      stroke(0, 0, 0);
    } else {
      stroke(255, 255, 255);
    }
    fill(getColorEllipse(s.getStoneColor()), 150);
    ellipse(x, y, Height / 2, Height / 2);
  }
}

void mousePressed() {
  inverted = !inverted;
}



color getColorEllipse(String stoneColor) {
  if (stoneColor.equals("dark red")) return color(139,0,0);
  if (stoneColor.equals("white")) return color(255,255,255);
  if (stoneColor.equals("dark green")) return color(0,100,0);
  if (stoneColor.equals("grey")) return color(125,125,125);
  if (stoneColor.equals("dark grey")) return color(169,169,169);
  if (stoneColor.equals("light grey")) return color(211,211,211);
  if (stoneColor.equals("brown")) return color(210,105,30);
  if (stoneColor.equals("red")) return color(255,0,0);
  if (stoneColor.equals("tan")) return color(210,180,140);
  if (stoneColor.equals("beige")) return color(245,245,220);
  if (stoneColor.equals("light brown")) return color(181,101,29);
  if (stoneColor.equals("black")) return color(30,30,30);
  if (stoneColor.equals("lime")) return color(0,255,0);
  if (stoneColor.equals("dark orange")) return color(255,140,0);
  if (stoneColor.equals("green")) return color(0,128,0);
  if (stoneColor.equals("pink")) return color(255,192,203);
  if (stoneColor.equals("gold")) return color(215,215,0);
  if (stoneColor.equals("yellow")) return color(255,255,0);
  if (stoneColor.equals("dark brown")) return color(101,67,33);
  return color(0,0,0);
}

int getTextureY(String texture) {
  if (texture.equals("smooth")) return 7;
  if (texture.equals("round")) return 6;
  if (texture.equals("waxy")) return 5;
  if (texture.equals("grainy")) return 4;
  if (texture.equals("rough")) return 3;
  if (texture.equals("jagged")) return 2;
  if (texture.equals("hard")) return 1;
  return 4;
}   

