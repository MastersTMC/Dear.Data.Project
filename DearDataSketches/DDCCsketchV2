//STONE CLASS
import java.util.ArrayList;

class Stone {
  public int number;
  public String stoneColor;
  public int size;
  public String texture;
  public String name;
  
  public Stone(int number, String stoneColor, int size, String texture, String name) {
    this.number = number;
    this.stoneColor = stoneColor;
   this.size = size;
   this.texture = texture;
   this.name = name;
  }
  
  public int getNumber() { 
    return number;
  }
  public String getStoneColor() {
    return stoneColor;
  }
   public int getSize() {
    return size;
  }
  public String getTexture() {
    return texture;
  }
  public String getName() {
    return name;
  }
  
}






